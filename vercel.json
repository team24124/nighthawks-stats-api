{
  "version": 2,
  "builds": [{"src":  "run.py", "use": "@vercel/python"}],
  "routes": [{"src": "/(.*)", "dest": "run.py"}],
  "crons": [
    {
      "path": "/api/cron/update",
      "schedule": "0 * * * 5,6,0"
    },
    {
      "path": "/api/cron/update",
      "schedule": "0 0 * * 1,2,3,4"
    }
  ]
}